  "red_flags": {
    "description": "Any red flag triggers auto-downgrade by ONE label (Hot→Warm, Warm→Cold, etc.)",
    "flags": [
      {
        "id": "deadline_too_short",
        "description": "Deadline < 10 days from publication (emergency/incumbent-favored)",
        "check": "deadline_submission - publication_date < interval '10 days'"
      },
      {
        "id": "invitation_only",
        "description": "Invitation-only procedure",
        "check": "title or summary contains 'inschrijving op uitnodiging'"
      },
      {
        "id": "late_detection_nvi",
        "description": "NvI round already occurred before first detection",
        "check": "tender_changes has nvi_round AND created_at > nvi_round detected_at"
      },
      {
        "id": "renewal_likely",
        "description": "Title contains verlenging or optie without nieuw — incumbent has strong advantage",
        "check": "title contains ('verlenging' OR 'optie') AND title NOT CONTAINS 'nieuw'"
      }
    ]
  },
  "auto_disqualify": {
    "description": "These conditions immediately set label=Disqualified, skip scoring",
    "conditions": [
      "Country != NL",
      "publication_type = 'gunning' (awarded notice)",
      "estimated_value_eur < 10000",
      "deadline_submission already passed",
      "title contains 'verlenging' or 'optie' without 'nieuw'"
    ]
  }
